# Terraform files
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# TODO: we are not using this currently, will take into account later on 
# *.tfvars
# *.tfvars.json

# Except example.tfvars that we want to share
!example.tfvars

# Ignore override files as they are usually used for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files
.terraform.lock.hcl

# Ignore environment variables file
.env

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.swp
*.swo
*.swm
*.swl
*.swk
*.swn
*.swi
*.swj

# Vim hidden backup files
.*.sw?
# OS generated files
.DS_Store
Thumbs.db
